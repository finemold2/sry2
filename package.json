{
  "name": "sry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "스크리브너(Scrivener) 핵심 기능을 재현한 브라우저 전용 글쓰기 웹앱. 본문은 실제 .rtf 파일로 저장/작성됩니다.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build && node scripts/build-pages.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:rtf": "node --experimental-strip-types src/rtf/rtf.test.ts",
    "test:export": "node --experimental-strip-types src/export/export.test.ts",
    "test:creative": "node --experimental-strip-types src/creative/creative.test.ts",
    "test:persistence": "node --experimental-strip-types src/persistence/persistence.test.ts",
    "test": "npm run test:rtf && npm run test:export && npm run test:creative && npm run test:persistence"
  },
  "dependencies": {
    "@twemoji/api": "^17.0.3",
    "@twemoji/svg": "^15.0.0",
    "docx": "^9.7.1",
    "idb": "^8.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.456.0",
    "mammoth": "^1.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.2"
  }
}
