d658"}, {"tool": "\uc808\ub2e8\uc2e0\uacf5 \uac15\ub3c4 \uc2a4\ucf54\uc5b4", "kind": "analysis", "desc": "\ud68c\ucc28 \ub05d \ubb38\uc7a5 \ud074\ub9ac\ud504\ud589\uc5b4 \uac15\ub3c4 \ucc44\uc810\ud574 \uc57d\ud55c \ud68c\ucc28 \uc801\ucd9c"}, {"tool": "\uc778\ubb3c \ub9d0\ud22c \uc9c0\ubb38 \ube44\uad50", "kind": "analysis", "desc": "\ub300\uc0ac \uc5b4\ubbf8\u00b7\ub9d0\ubc84\ub987 \uc9c0\ubb38\ud654\ud574 \ub9d0\ud22c \ub2ee\uc73c\uba74 \uacbd\uace0"}, {"tool": "\uc138\uacc4\uad00 \uc6a9\uc5b4 \uc0c9\uc778\u00b7\ud1b5\uc77c", "kind": "analysis", "desc": "\uc870\uc5b4 \ucd94\ucd9c\ud574 \uc0c9\uc778 \ub9cc\ub4e4\uace0 \ud45c\uae30 \ud754\ub4e4\ub9bc \ud1b5\uc77c \uc81c\uc548"}, {"tool": "\ud3c9\uba74 \uc7a5\uba74 \uac10\uac01 \uc54c\ub9bc", "kind": "analysis", "desc": "\uc18c\ub9ac\u00b7\ub0c4\uc0c8\u00b7\ucd09\uac01 0\uc778 \ud3c9\uba74 \uc7a5\uba74 \uc9da\uc5b4 \ub2e8\uc5b4 \uc740\ud589 \uc9c1\ub9c1\ud06c"}, {"tool": "\uac08\ub4f1 \uacf5\ubc31 \uc9c0\ub3c4", "kind": "analysis", "desc": "\ubb34\uac08\ub4f1 \ud1b5\uacfc \uc7a5\uba74\u00b7\uc5f0\uc18d \ucc98\uc9d0 \uad6c\uac04 \uacbd\uace0 \ud398\uc774\uc2f1 \uc9c4\ub2e8"}, {"tool": "\ud1f4\uace0 \ud328\uc2a4 \uccb4\ud06c\ud3ec\uc778\ud2b8", "kind": "feature", "desc": "\uad6c\uc870\u00b7\ubb38\uc7a5\u00b7\uc624\ud0c8\uc790 \ub2e4\ub2e8\uacc4 \ud1f4\uace0\ub97c \uccb4\ud06c\ubc15\uc2a4\ub85c \ud2b8\ub798\ud0b9"}, {"tool": "\ub450 \ubc84\uc804 \ub098\ub780\ud788 \ud569\uc131", "kind": "feature", "desc": "\uc2a4\ub0c5\uc0f7 \ub458\uc744 \ubb38\uc7a5 \ub2e8\uc704 \ucc44\ud0dd\ud574 \ud569\uc131\ud558\ub294 A/B \ube44\uad50"}, {"tool": "\uc9d1\ud544 \uc2a4\ud2b8\ub9ad \uc815\uc6d0", "kind": "feature", "desc": "\uc5f0\uc18d \uc9d1\ud544\uc77c\uc744 \uc2dd\ubb3c \uc790\ub77c\ub294 \ud53d\uc140 \uc815\uc6d0\uc73c\ub85c \uc2dc\uac01\ud654"}, {"tool": "\ub9c9\ud798 \ud0c8\ucd9c \ub8f0\ub81b", "kind": "generator", "desc": "\uba48\ucd94\uba74 \ub9e5\ub77d \ub9de\ucd98 \ub3cc\ubc1c \ub4f1\uc7a5\u00b7\ub0a0\uc528 \uae09\ubcc0 \uc804\uac1c \uc81c\uc548"}, {"tool": "\uc5ed\uc544\uc6c3\ub77c\uc778 \uc790\ub3d9 \ucd94\ucd9c", "kind": "analysis", "desc": "\ubcf8\ubb38\uc11c \ud575\uc2ec \uc0ac\uac74 \uac70\uafb8\ub85c \ubf51\uc544 \uc758\ub3c4\uc640 \uc5b4\uae0b\ub0a8 \uc810\uac80"}, {"tool": "\ub3c5\uc790 \ud398\ub974\uc18c\ub098 \ubaa8\uc758 \ub9ac\ubdf0", "kind": "feature", "desc": "AI\uc5d0 \ubb34\ud611\u00b7\ub85c\ud310 \ub3c5\uc790 \ud398\ub974\uc18c\ub098 \ubd80\uc5ec\ud574 \ubaa8\uc758 \ubca0\ud0c0\ub9ac\ub529"}, {"tool": "\uacf5\uac04 \ub3d9\uc120 \uc9c0\ub3c4", "kind": "analysis", "desc": "\uc778\ubb3c \uc704\uce58\u00b7\uc774\ub3d9\u00b7\uc18c\ud488 \ud1a0\ud070 \ubc30\uce58\ud574 \ubb34\ub300 \ub3d9\uc120 \ubaa8\uc21c \uc801\ucd9c"}, {"tool": "\ud0a4\uc6cc\ub4dc \uc57d\uc18d-\uc774\ud589 \ub9e4\uce6d", "kind": "analysis", "desc": "\uc18c\uac1c\uae00 \ud0a4\uc6cc\ub4dc\uac00 \ubcf8\ubb38\uc11c \ub2e4\ub904\uc9c4 \ube44\uc911 \ub9e4\uce6d\ud574 \uc774\ud589\ub3c4 \uc810\uac80"}]
