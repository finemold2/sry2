[{"tool": "\uc778\ubb3c \uc9c0\uc2dd \uc9c0\ub3c4", "kind": "analysis", "desc": "\ube44\ubc00 \uacf5\uac1c \uc2dc\uc810 \ucd94\uc801\ud574 \ubaa8\ub97c \uc778\ubb3c\uc774 \ubbf8\ub9ac \uc544\ub294 \ubaa8\uc21c \uacbd\uace0"}, {"tool": "\uc124\uc815\uac12 \ub4dc\ub9ac\ud504\ud2b8 \ucd94\uc801\uae30", "kind": "analysis", "desc": "\ub208\uc0c9\u00b7\ub098\uc774 \ub4f1 \uace0\uc815 \uc0ac\uc2e4\uc774 \ubcf8\ubb38\uc11c \ub2e4\ub978 \uac12\uc774\uba74 \ucda9\ub3cc \uc801\ucd9c"}, {"tool": "\uc2dc\uac04\ud45c\ud604 \ud0c0\uc784\ub77c\uc778 \ubd95\uad34\uac10\uc9c0", "kind": "analysis", "desc": "\uc2dc\uac04\uad6c \ub204\uc801\ud574 \ubc24 \ub4a4 \uc544\uce68 \ubaa8\uc21c\u00b7\ub0a0\uc9dc \ubd88\uc77c\uce58 \ud45c\uc2dc"}, {"tool": "\ud68c\ucc28 \ub3c4\uc785\ubd80 \uc704\ud5d8\uad6c\uac04 \uc810\uac80", "kind": "analysis", "desc": "\uccab 3\ubb38\ub2e8\ub9cc \ubaa8\uc544 \uc7ac\ud638\uba85\u00b7\uc7a5\uc18c\u00b7\ud6c5 \ud68c\uc218 \uc810\uac80"}, {"tool": "\uc874\ub313\ub9d0\u00b7\ud638\uce6d \uc77c\uad00\uc131 \uac80\uc0ac", "kind": "analysis", "desc": "\ub450 \uc778\ubb3c \ubc18\ub9d0\u00b7\uc874\ub300\u00b7\ud638\uce6d\uc774 \uc804\ud658\uc810 \uc5c6\uc774 \ubc14\ub00c\uba74 \ucd94\uc801"}, {"tool": "\ubbf8\ud68c\uc218 \ubcf5\uc120 \ub808\uc774\ub354", "kind": "analysis", "desc": "\uc608\uace0 \ubb38\uc7a5\uacfc \ud68c\uc218 \uc548 \ub41c \ub5a1\ubc25\uc744 \ubc88\ud638\uc640 \ubaa9\ub85d\ud654"}, {"tool": "\uac10\uc815 \uc628\ub3c4 \ud788\ud2b8\ub9f5", "kind": "analysis", "desc": "\uac10\uc815 \uc5b4\ud718\ub97c \uc0c9\uc628\ub3c4\ub85c \ud658\uc0b0\ud574 \ub2e8\uc870 \uc815\uc11c \uad6c\uac04 \uc2dc\uac01\ud654"}, {"tool": "\uc778\ubb3c \ubb34\ub300 \uc810\uc720\uc728 \uac04\ud2b8", "kind": "analysis", "desc": "\ub4f1\uc7a5\u00b7\uc774\ud0c8 \uac04\ud2b8\ub85c \uc0ac\ub77c\uc9c4 \uc870\uc5f0\u00b7\ub3d9\uc2dc \uacfc\ubc00 \uc9c4\ub2e8"}, {"tool": "\ub300\uc0ac\u00b7\uc9c0\ubb38 \ub9ac\ub4ec \ud30c\ud615", "kind": "analysis", "desc": "\ub300\uc0ac\u00b7\uc9c0\ubb38\u